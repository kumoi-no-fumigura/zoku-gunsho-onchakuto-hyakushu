   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "あやにくにまたすはなれもかくまてはつれおからしを山郭公",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "侍郭公",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "明方は一かたならぬほとゝきす月をなこりに声やありそふ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公遍",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "かりのこすかけかと見えて池水にふきし軒端のあやめうつろふ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "ふれにける袖かとはかり立岡の香をかくはしみさそふ夕帆",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菖蒲",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "書きとめぬ水上いかに天河雲よりあまるさみたれの比",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "堪五月あ",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "みるに花の秋をそまたぬなてしこの咲そふ色春しる夏草",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "茂りそふ月のかつらはさはらぬを明るそつらきみしかよの空",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "ねやにたし煙やうす〴〵成ぬらんめとよりも又しけき蚊の声",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蚊遣火",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "一月いてぬ空にみたれてよるひかる玉をやみする谷なるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "第四貞",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "一蓮葉は茂りにけりな曇なき池のかゝみもくもかはかりに",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池蓮",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "なか雨にまさりしよりも瀧津せは猶音たかき夕立のほと",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "岩御水結ふ袂の涼しさや夏山なからあきの夕かけ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納涼",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "松かせも袖に涼しく吹をくれみそきにかへる志賀の浦風",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "六月抜",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "今よりハ桐の一葉に数そひて見るへき月の秋やきぬらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "彦星も色瀬まつまハおやおもふ雲のはたての天の川なみ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "音たて露吹風も夢さへもむすひやはする軒の下落",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "詠れは山のにしきに先たちて色とる野辺の秋はきの花",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "秋風になひきやすくてあたなりと名にしおふ野の女郎名はし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "女郎花",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "あるか中にえらひもてきて草深た野辺より庭の松虫とこゑは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蓑虫",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "て飛もそれかとたくふ声の音に引とゝめてよ初かりの声",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初雁",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "明はなれ帰る門田の跡にしも友したひてや鹿の鳴らん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田鹿",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "哀れさの夕にたへす昔よりうき秋とたれいひもそめけん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "晴やらて入さの山と見へなから影ハ雲まにあり明の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山月",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "梅姫のしたひみるにもいかはかりかたふく月はうちの川なみ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋月",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "今まてもまた見けの江の月影をおもへとくやし天のはしたて",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦月",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "暮るより光さしそふかたそたの行あひにこゆる月読の杜",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "社預月",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "かき置しふることのはも思ひ出てぬ石山寺の月にむかひて",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古寺月",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "夕より床はなれすもあくるまてふしみの沢の略の羽かき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁鴫",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "吹めくる風につけてやあやしくも里なきかたに衣打こるへ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "をはつとやまた夜をのこす朝霧にむせふ川瀬の音はかりして",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河霧",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "白砂の霜にみとりの菊のも花よりはなの下かさねかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菊",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "色は春の花もおよはぬ枝をみよ山さくら戸の秋のもみちも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "一替人にへたてはあらし秋にけふかきりとしたふこゝろはかりは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "九月尽",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "松杉に色をのこして木からしのかけも御ひしく水やきにけり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "さしなからぬるゝ口影にほしもあへす雲の衣やしくれさぬらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時雨",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "一右風に枝よりちると数若くも又さそはれてゆく木のはかな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "さきたちし人もしられてかけはしの霜に諸ある朝ほらけ哉",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "これ",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "茂りつる牛てみしま江のいつしかに冬枯はてゝそよく芦原",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒茅",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "寒き夜もおほへすむかふ光かな月の御船に心ひかれて",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "春はまたさそはん水のうき草の根さしとゝめて氷る池かな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "すまの浦や磯部にたかしたる浪もしられて空に鳴千鳥よな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千馬",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "くるゝ江のうきねの床も氷ゐてくかにまとへと水と水と",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "さよ衣かさぬるたにも揃へにけりさそな細代の床の川尻",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "細代",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "ふりくるを都のうちにいつかはとむよふも遠きみねの和曽",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶺雪",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "〽明ぬるか雪の光にみかゝれてふかき夜しらぬ玉しきの庭",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭雪",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "かた野にやみゆきまたまし御狩せし代々のむかしも諸をしたひて",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "小野山のあらしは雪を吹ませて煙もさむし霞のすみかま",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭竃煙",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "〽おすこともなきをうき身に嘆かすは暮行年はさのみしたはし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "とけなんもしらてなとかはとき人を思ひそめにし中のした紐は",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "第八初恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "ひまもなく哀れかはりぬ家袖はしのふのこらの波のした草",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍慈",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "神にいのるしるしあらんのなくさめもあまり年ふる契",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "新恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "しるさりき語るよりてぬ人の上を聞てもかたる思ひせんとは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "一露の身も思ひきへなて同し世にあらはつれなき限りをやらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "忘るなよ行衛はともに涙川あさからすしもちきる心を",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "貞応",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "人心うしあめたきにあへてまたたのまれかたきあふさかの関",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "きぬ〳〵をしたひて鳥の空音かとかことあやなき段の横雲",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別応",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "俤に枕ならふる夢さめて又ねかなしきしのゝめつ床",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後朝恋",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "一ひれふりし音もいかにかへりこん程をまつらの髪わひしき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠右衛門",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "一しるやいかにとはかりかこつまきの物もなけれはさすかなるゝ心を",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "第九則応",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "うたくねのあとにおちゝる玉つさにあらはれそむる契くるしも",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "顕応",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "聞てのこ有へき物をあひみすはまさりてかゝかゝか歎きせましや",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "増慈",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "家心猶こりすまに偽とおもふもいく夜待あかしけん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "伝慈",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "悔しくもしらてうつろふあた人の心の花の跡をとふかな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "悔恋",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "いつか風の便りはきかむつれなさも松をためしに年をふる中",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "経年恋",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "さすかにも忘れはてしとことゝふも又すしらぬ世のこたへのみして",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘恋",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "なひかぬをまつ我さへもつれなしやひくらへに思ひよはして",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘恋",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "身には猶しけりそひぬる思ひ草人にしわくる根さしとも哉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "思片右",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "ことに出んつもる恨こはものやことなりつゝよそに見へもこそせめ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "むかひつゝ心すむにそ思ひやるそのあかつきの月はいかにと",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "第十暁",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "夕浪に吹すてゝまた浦風のやとりにかへるすみよしの松",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所松",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "竹のちの露ちる音は空にしもしらぬ留きし窓の涼しさ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "窓竹",
   "kotobagaki": ""
  },
  {
   "seq": "104",
   "text": "馴てたにきけは淋しな柴の戸は嶺のあらしに山水の声",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "105",
   "text": "夕顔の花にもはにもかくろひて田中の病はすむはしられし",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家",
   "kotobagaki": ""
  },
  {
   "seq": "106",
   "text": "関山やわかれて又と契るにもいつかはかへる都ならまし",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "羇旅",
   "kotobagaki": ""
  },
  {
   "seq": "107",
   "text": "おろかなる身とてもらす出玉くしけ二つの道の神の恋は",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "108",
   "text": "〽国々の神の宮井も天地のひしけしよかやさためおきけん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祗",
   "kotobagaki": ""
  },
  {
   "seq": "109",
   "text": "一今の世につたへはたゝんはしの山しな〳〵とける御法ならすは",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "釈教",
   "kotobagaki": ""
  },
  {
   "seq": "110",
   "text": "君か代をあふかさらめやかしこきかおさめし他の国のたはしに",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝",
   "kotobagaki": ""
  }
 ],
 "catalog": {
