   "ban": "",
   "side": "",
   "dai": "十七月",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "しつかにて夕まひしき草の庵に音聞程の春の雨かな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "名の思ふ春に一たひ行雁のとこよりすれてかへらすも哉",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "廿八丁帰雁",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "山賤のしらてや折ものこすらんふかき岩木のかけの早蕨",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "第二早蕨",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "いかてかは散を恨みしつらさにもこりす植そふ花にはあるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "裁図",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "咲ぬやといりてかりぬの夢にさへまたみぬ花を尋行山",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "尋蔵",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "盛なる花に梢はかつもれてこゑこそきかね雪の下折",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "盛花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "おらてしも帰るはさそなうらやまん花のにしきを袖のかさしは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "折花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "ちれは猶みとりもしろくみ山木にさかせて花のあらし吹なり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "引しめもせきやる袖も水口ふかけやみるらん小田の苗代",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "苗代",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "川浪に咲てうつろふ色はたゝうき藻花さく岸の歓冬",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "よるのまに岡のしからみかけそめて雫もふかく松の藤浪",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "暮行もしらし物をとがそへこし日数くやしき春にも有かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "しゐて猶花の衣やかさねましけふぬきかふる習ひならすは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "更衣",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "神山にけさ分入て諸葉草かけつゝ露の玉かつらせり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "葵",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "あやにくにまたすはなれもかくまてはつれおからしを山郭公",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "侍郭公",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "盛なる花に梢はかつもれてうゑこそきかね雪の下折",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733157",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三九",
   "kotobagaki": ""
  },
